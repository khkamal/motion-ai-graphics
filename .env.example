# Persistent local SQLite database file.
DATABASE_URL="file:./prisma/dev.db"

# Required in production. Generate separate values with: openssl rand -base64 32
API_KEY_ENCRYPTION_KEY=""
WORKSPACE_SECRET=""

# Gemini model used for image-aware prompt variation.
GEMINI_MODEL="gemini-2.5-flash"

# FFmpeg is bundled for Linux x64 local/self-hosted Node deployments.
# For a custom build, set: FFMPEG_PATH="/usr/bin/ffmpeg"
